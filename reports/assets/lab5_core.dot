digraph G { graph [rankdir=TB, bgcolor="white", nodesep=0.24, ranksep=0.40, pad=0.10]; node [shape=plain, fontname="Tinos", fontsize=12]; edge [fontname="Tinos", fontsize=10, arrowsize=0.7];
c [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="CENTER" BALIGN="CENTER">PlannerController : QObject</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">m_plan : StudyPlan<BR ALIGN="LEFT"/>m_path : QString</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ addTask(), updateTask()<BR ALIGN="LEFT"/>+ addSession(), removeTask()<BR ALIGN="LEFT"/>+ importData(), backup()<BR ALIGN="LEFT"/>changed() [signal]</TD></TR></TABLE>>];
p [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="CENTER" BALIGN="CENTER">StudyPlan</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">m_tasks : vector&lt;Task&gt;<BR ALIGN="LEFT"/>m_sessions : vector&lt;StudySession&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ addTask(), updateTask()<BR ALIGN="LEFT"/>+ addSession(), removeSession()<BR ALIGN="LEFT"/>+ summary(), bySubject()<BR ALIGN="LEFT"/>+ replaceData()</TD></TR></TABLE>>];
s [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="CENTER" BALIGN="CENTER">PlannerStorage</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ save(path, plan, error)<BR ALIGN="LEFT"/>+ load(path, plan, error)<BR ALIGN="LEFT"/>+ exportCsv(path, plan, error)</TD></TR></TABLE>>];
t [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="CENTER" BALIGN="CENTER">Task</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">id : int<BR ALIGN="LEFT"/>subject, title : string<BR ALIGN="LEFT"/>deadline : string<BR ALIGN="LEFT"/>priority : Priority<BR ALIGN="LEFT"/>status : Status<BR ALIGN="LEFT"/>plannedMinutes : int</TD></TR></TABLE>>];
ss [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="CENTER" BALIGN="CENTER">StudySession</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">id, taskId : int<BR ALIGN="LEFT"/>date : string<BR ALIGN="LEFT"/>minutes : int<BR ALIGN="LEFT"/>note : string</TD></TR></TABLE>>];
c -> p [arrowtail=diamond,dir=both,arrowhead=none]; c -> s [style=dashed,label="чтение / запись"]; s -> p [style=dashed,constraint=false]; p -> t [arrowtail=diamond,dir=both,arrowhead=none]; p -> ss [arrowtail=diamond,dir=both,arrowhead=none]; ss -> t [label="taskId",headlabel="1",taillabel="0..*",constraint=false]; {rank=same;p;s;} {rank=same;t;ss;}
}