digraph G { graph [rankdir=TB, bgcolor="white", nodesep=0.24, ranksep=0.40, pad=0.10]; node [shape=plain, fontname="Tinos", fontsize=12]; edge [fontname="Tinos", fontsize=10, arrowsize=0.7];
w [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="CENTER" BALIGN="CENTER">MainWindow : QWidget</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">m_model : StampModel*<BR ALIGN="LEFT"/>m_view : StampTableView*</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">− addStamp(), editStamp()<BR ALIGN="LEFT"/>− removeStamp()<BR ALIGN="LEFT"/>− openFile(), saveFile()</TD></TR></TABLE>>];
m [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="CENTER" BALIGN="CENTER">StampModel<BR ALIGN="CENTER"/>: QAbstractTableModel</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">m_stamps : QVector&lt;Stamp&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ data(), setData()<BR ALIGN="LEFT"/>+ addStamp(), updateStamp()<BR ALIGN="LEFT"/>+ removeStampAt()</TD></TR></TABLE>>];
v [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="CENTER" BALIGN="CENTER">StampTableView<BR ALIGN="CENTER"/>: QTableView</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ currentRow()</TD></TR></TABLE>>];
d [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="CENTER" BALIGN="CENTER">StampDialog : QDialog</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ setStamp(), stamp()</TD></TR></TABLE>>];
e [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="CENTER" BALIGN="CENTER">StampDelegate<BR ALIGN="CENTER"/>: QStyledItemDelegate</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ createEditor()<BR ALIGN="LEFT"/>+ setEditorData()<BR ALIGN="LEFT"/>+ setModelData()</TD></TR></TABLE>>];
st [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="CENTER" BALIGN="CENTER">Stamp</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">title, country : QString<BR ALIGN="LEFT"/>year, circulation : int</TD></TR></TABLE>>];
s [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="CENTER" BALIGN="CENTER">StampStorage</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ save(path, stamps, error)<BR ALIGN="LEFT"/>+ load(path, stamps, error)</TD></TR></TABLE>>];
w -> m [arrowtail=diamond,dir=both,arrowhead=none]; w -> v [arrowtail=diamond,dir=both,arrowhead=none]; w -> d [style=dashed,label="диалог"]; v -> m [style=dashed,label="model",constraint=false]; v -> e [style=dashed,label="delegate"]; m -> st [arrowtail=diamond,dir=both,arrowhead=none]; d -> st [style=dashed]; {rank=same;v;m;} {rank=same;e;st;}w -> s [style=dashed,label="файл"]; s -> st [style=dashed,label="сериализация"]; {rank=same;d;s;}
}